{
  "opencollection": "1.0.0",
  "info": {
    "name": "ConductorOne Access Conflict Role API",
    "version": "0.1.0-alpha"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Role",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{tenantDomain}.conductor.one/api/v1/iam/roles",
            "params": [
              {
                "name": "page_size",
                "value": "",
                "type": "query"
              },
              {
                "name": "page_token",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "List all roles for the current user."
        },
        {
          "info": {
            "name": "Get",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{tenantDomain}.conductor.one/api/v1/iam/roles/:role_id",
            "params": [
              {
                "name": "role_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Get a role by id."
        },
        {
          "info": {
            "name": "Update",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{tenantDomain}.conductor.one/api/v1/iam/roles/:role_id",
            "params": [
              {
                "name": "role_id",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Update a role by passing a Role object."
        }
      ]
    }
  ],
  "bundled": true
}