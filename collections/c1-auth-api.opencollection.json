{
  "opencollection": "1.0.0",
  "info": {
    "name": "ConductorOne Access Conflict Auth API",
    "version": "0.1.0-alpha"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Auth",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Introspect",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{tenantDomain}.conductor.one/api/v1/auth/introspect"
          },
          "docs": "Introspect returns the current user's principle_id, user_id and a list of roles, permissions, and enabled features."
        }
      ]
    }
  ],
  "bundled": true
}