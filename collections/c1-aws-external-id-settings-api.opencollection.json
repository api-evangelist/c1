{
  "opencollection": "1.0.0",
  "info": {
    "name": "ConductorOne Access Conflict AWS External ID Settings API",
    "version": "0.1.0-alpha"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "AWS External ID Settings",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{tenantDomain}.conductor.one/api/v1/settings/aws-external-id"
          },
          "docs": "Invokes the c1.api.settings.v1.AWSExternalIDSettings.Get method."
        }
      ]
    }
  ],
  "bundled": true
}