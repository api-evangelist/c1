              },
              {
                "name": "page_token",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Invokes the c1.api.settings.v1.OrgDomainService.List method."
        },
        {
          "info": {
            "name": "Update",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://{tenantDomain}.conductor.one/api/v1/settings/domains",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Invokes the c1.api.settings.v1.OrgDomainService.Update method."
        }
      ]
    }
