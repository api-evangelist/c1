{
  "opencollection": "1.0.0",
  "info": {
    "name": "ConductorOne Access Conflict Function Tag API",
    "version": "0.1.0-alpha"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Function Tag",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List Tags",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{tenantDomain}.conductor.one/api/v1/functions/:function_id/tags",
            "params": [
              {
                "name": "function_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "ListTags lists all tags for a function"
        },
        {
          "info": {
            "name": "Create Tag",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{tenantDomain}.conductor.one/api/v1/functions/:function_id/tags",
            "params": [
              {
                "name": "function_id",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "CreateTag creates a named reference to a specific commit"
        }
      ]
    }
  ],
  "bundled": true
}