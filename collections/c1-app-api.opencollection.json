{
  "opencollection": "1.0.0",
  "info": {
    "name": "ConductorOne Access Conflict App API",
    "version": "0.1.0-alpha"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "App",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{tenantDomain}.conductor.one/api/v1/apps",
            "params": [
              {
                "name": "page_size",
                "value": "",
                "type": "query"
              },
              {
                "name": "page_token",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "List all apps."
        },
        {
          "info": {
            "name": "Create",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{tenantDomain}.conductor.one/api/v1/apps",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create a new manual app without a connector."
        },
        {
          "info": {
            "name": "Get",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{tenantDomain}.conductor.one/api/v1/apps/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Get an app by ID."
        },
        {
          "info": {
            "name": "Update",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{tenantDomain}.conductor.one/api/v1/apps/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Update an existing app."
        },
        {
          "info": {
            "name": "Delete",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://{tenantDomain}.conductor.one/api/v1/apps/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Delete an app."
        },
        {
          "info": {
            "name": "Search",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{tenantDomain}.conductor.one/api/v1/search/apps",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Search apps based on filters specified in the request body."
        }
      ]
    }
  ],
  "bundled": true
}