{
  "opencollection": "1.0.0",
  "info": {
    "name": "ConductorOne Access Conflict Personal Client API",
    "version": "0.1.0-alpha"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
