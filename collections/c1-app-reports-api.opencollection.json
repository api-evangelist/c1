{
  "opencollection": "1.0.0",
  "info": {
    "name": "ConductorOne Access Conflict App Reports API",
    "version": "0.1.0-alpha"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "App Reports",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{tenantDomain}.conductor.one/api/v1/apps/:app_id/report",
            "params": [
              {
                "name": "app_id",
                "value": "",
                "type": "path"
              },
              {
                "name": "page_size",
                "value": "",
                "type": "query"
              },
              {
                "name": "page_token",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Get a list of reports for the given app."
        },
        {
          "info": {
            "name": "Generate Report",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{tenantDomain}.conductor.one/api/v1/apps/:app_id/report",
            "params": [
              {
                "name": "app_id",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Generate a report for the given app."
        }
      ]
    }
  ],
  "bundled": true
}